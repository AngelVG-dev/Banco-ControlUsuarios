<UserControl x:Name="ucUsuario" x:Class="Banco.View.UsuarioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Banco.View"
             Height="600" Width="700"
             Background="Transparent" Loaded="ucUsuario_Loaded">

    <UserControl.Resources>
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#462AD8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#28AEED"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="509*"/>
            <ColumnDefinition Width="171*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
        </Grid.RowDefinitions>


        <GroupBox Header="Datos del Usuario"
                  Foreground="White"
                  FontFamily="Montserrat"
                  FontWeight="Bold"
                  BorderBrush="#462AD8"
                  Background="Transparent"
                  Padding="15"
                  Grid.Row="0" Grid.RowSpan="2" Margin="0,0,10,19" Grid.ColumnSpan="2">
            <Grid Height="196" Margin="0,0,309,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Nombre" Grid.Row="1" Grid.Column="0" Foreground="White" Margin="0,10,10,5"/>
                <TextBox x:Name="txtNombre" Grid.Row="1" Grid.Column="1" Margin="0,10,0,5" Background="Transparent" Foreground="White" KeyUp="txtNombre_KeyUp"/>

                <TextBlock Text="Usuario" Grid.Row="2" Grid.Column="0" Foreground="White" Margin="0,10,10,5"/>
                <TextBox x:Name="txtUsuario" Grid.Row="2" Grid.Column="1" Margin="0,10,0,5" Background="Transparent" Foreground="White"/>

                <TextBlock Text="Contraseña" Grid.Row="3" Grid.Column="0" Foreground="White" Margin="0,10,10,5"/>
                <PasswordBox x:Name="pwdContraseña" Grid.Row="3" Grid.Column="1" Margin="0,10,0,5" Background="Transparent" Foreground="White"/>

                <TextBlock Text="Rol" Grid.Row="4" Grid.Column="0" Foreground="White" Margin="0,10,10,5"/>
                <ComboBox x:Name="cmbRol" Grid.Row="4" Grid.Column="1" Margin="0,10,0,5" Width="158">
                    <ComboBoxItem Content="Administrativo"/>
                    <ComboBoxItem Content="Cliente"/>
                </ComboBox>

                <TextBlock Text="Estado" Grid.Row="5" Grid.Column="0" Foreground="White" Margin="0,10,10,5"/>
                <ComboBox x:Name="cmbEstado" Grid.Row="5" Grid.Column="1" Margin="0,10,0,5" Width="158">
                    <ComboBoxItem Content="Activo"/>
                    <ComboBoxItem Content="Inactivo"/>
                </ComboBox>
            </Grid>
        </GroupBox>


        <GroupBox Header="Acciones"
                  Foreground="White"
                  FontFamily="Montserrat"
                  FontWeight="Bold"
                  BorderBrush="#462AD8"
                  Background="Transparent"
                  Padding="15"
                  Grid.Row="0" Grid.RowSpan="2" Margin="368,10,10,63" Grid.ColumnSpan="2">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                <Button x:Name="btnGuardarUsuario" Content="Guardar" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,10" Click="btnGuardarUsuario_Click"/>
                <Button x:Name="btnEditarUsuario" Content="Editar" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,10" Click="btnEditarUsuario_Click"/>
                <Button x:Name="btnLimpiarUsuario" Content="Limpiar" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,10" Click="btnLimpiarUsuario_Click"/>
                <Button x:Name="btnSalirUsuario" Content="Salir" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,0" Click="btnSalirUsuario_Click"/>
            </StackPanel>
        </GroupBox>


        <DataGrid x:Name="dgUsuarios"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  Background="White"
                  HeadersVisibility="Column"
                  FontFamily="Montserrat"
                  AlternatingRowBackground="#F0F0F0"
                  CanUserAddRows="False"
                  Margin="0,261,0,0" Grid.RowSpan="2" Grid.ColumnSpan="2" SelectionChanged="dgUsuarios_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="UsuarioID" Binding="{Binding UsuarioID}" Width="65"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*"/>
                <DataGridTextColumn Header="Contraseña" Binding="{Binding Contraseña}" Width="*"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="*"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
