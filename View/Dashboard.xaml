<Window x:Class="Banco.View.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Banco.View"
        mc:Ignorable="d"
           Height="690" Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="20"
            Background="#1b1448"
            BorderBrush="Blue"
            BorderThickness="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <!-- Encabezado -->
                <RowDefinition/>
                <!-- Contenido -->
            </Grid.RowDefinitions>

            <!-- ENCABEZADO SUPERIOR -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="325*" />
                    <ColumnDefinition Width="133*"/>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Panel de Control"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           Foreground="DarkGray"
                           FontSize="24"
                           FontFamily="Montserrat" Grid.ColumnSpan="2"/>

                <!-- Botón Minimizar -->
                <Button x:Name="btnMinimize"
                        Grid.Column="2"
                        BorderThickness="0"
                        Content="-"
                        Foreground="White"
                        FontSize="16"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        Click="btnMinimize_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#28AEED"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#278BEF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Botón Cerrar -->
                <Button x:Name="btnClose"
                        Grid.Column="3"
                        BorderThickness="0"
                        Content="X"
                        Foreground="White"
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        Click="btnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#DA34AE"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C62DAE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- CONTENIDO PRINCIPAL -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <!-- Menú lateral -->
                    <ColumnDefinition/>
                    <!-- Contenido -->
                </Grid.ColumnDefinitions>

                <!-- MENÚ LATERAL IZQUIERDO -->
                <StackPanel Background="#20194E" Grid.Column="0">
                    <StackPanel.Resources>
                        <Style x:Key="MenuButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontFamily" Value="Montserrat"/>
                            <Setter Property="Margin" Value="10,5"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="10">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#462AD8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>

                    <!-- Imagen y título -->
                    <Image Source="/Imagenes/LogBanco.png" Width="160" Height="160" Margin="30"/>
                    <TextBlock Text="Banco ARP"
               Foreground="White"
               FontSize="20"
               FontFamily="Montserrat"
               HorizontalAlignment="Center"
               Margin="0,10,0,20"/>

                    <!-- Botones de navegación -->
                    <!-- Botones de navegación -->
                    <Button x:Name="btnCliente" Content="Cliente" Style="{StaticResource MenuButtonStyle}" Click="Button_Click" />
                    <Button x:Name="btnCajero" Content="Cajero" Style="{StaticResource MenuButtonStyle}" />
                    <Button x:Name="btnCuenta" Content="Cuenta" Style="{StaticResource MenuButtonStyle}" Click="btnCuenta_Click" />
                    <Button x:Name="btnTarjeta" Content="Tarjeta" Style="{StaticResource MenuButtonStyle}" Click="btnTarjeta_Click" />
                    <Button x:Name="btnUsuario" Content="Usuario" Style="{StaticResource MenuButtonStyle}" Click="btnUsuario_Click" />
                    <Button x:Name="btnCerrarSesion" Content="Cerrar Sesion" Style="{StaticResource MenuButtonStyle}" Click="btnCerrarSesion_Click" />
                </StackPanel>

                <!-- Zona de contenido -->
                <Grid Grid.Column="1" x:Name="ContentArea">
                    <!-- Aquí se cargará el UserControl dinámicamente -->
                </Grid>


            </Grid>
        </Grid>
    </Border>
</Window>
